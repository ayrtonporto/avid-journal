# Keep config/ in the image for import compatibility

# Local env
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Docker itself
Dockerfile
docker-compose.yaml
.dockerignore

# Large caches (MiniLM is pre-downloaded in the build)
cache/
