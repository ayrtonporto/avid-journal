# Docker build context — exclude only what's not needed for the full pipeline

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Git
.git/
.gitignore

# Not needed for the demo
vendor/
tests/
scripts/
docs/
examples/
Numina Lean Agent/
lean_papers/
audit/
.claude/
.claire/

# Local env files (use .env mount instead)
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Docker self-reference
Dockerfile
docker-compose.yaml
.dockerignore

# Large caches (will be rebuilt/generated in container)
cache/
