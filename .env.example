# AViD Journal — Environment configuration
# Copy this to .env and fill in the values.
# NEVER commit .env to git.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# OpenCode Go API key (for DeepSeek V4 Pro + V4 Flash)
# Get one at: https://opencode.ai
OPENCODE_GO_API_KEY=sk-...

# Google OAuth client ID (for Sign in with Google)
# Create one at: https://console.cloud.google.com/apis/credentials
# Add authorized origins: https://your-domain.com
# Add redirect URIs: https://your-domain.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── OPTIONAL: Email notifications ───────────────────────────────────────────

# SMTP settings for sending submission confirmation emails.
# Leave empty to disable email sending (submissions still work, just no emails).
# Gmail example: smtp.gmail.com:587 with an App Password.
AVID_SMTP_HOST=smtp.gmail.com
AVID_SMTP_PORT=587
AVID_SMTP_USER=your-email@gmail.com
AVID_SMTP_PASS=your-app-password
AVID_SMTP_FROM=avid-journal@nousresearch.com

# ── OPTIONAL: Pipeline toggles ──────────────────────────────────────────────

# Lean 4 project directory (for D2 triviality checks)
# Must contain Mathlib compiled with `lake build`.
# Set to empty or a non-existent path to disable D2.
LEAN_PROJECT_DIR=lean_project

# Disable components for lightweight deployments
# AVID_FORMALIZATION_ENABLED=0   # skip LaTeX→Lean translation
# AVID_D2_ENABLED=0              # skip triviality filter

# ── OPTIONAL: Models ────────────────────────────────────────────────────────

# Override default models (server provides DeepSeek V4 Pro + V4 Flash)
# AVID_FORMALIZATION_MODEL=deepseek-v4-pro
# AVID_JUDGE_MODEL=deepseek-v4-flash
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# ── REQUIRED: Cloudflare Tunnel (for exposing to your domain) ────────────────

# Create a tunnel at https://one.dash.cloudflare.com/
# → Networks → Tunnels → Create tunnel → copy the token:
CLOUDFLARE_TUNNEL_TOKEN=
