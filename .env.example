# AViD Journal — environment configuration
# Copy this file to .env and fill in the values.  NEVER commit .env to git.
#
# For a first deploy you only strictly need OPENCODE_GO_API_KEY. Everything
# else has a sensible default or is only needed once auth is turned on.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# OpenCode Go API key — powers formalization (DeepSeek V4 Pro) and the D1 LLM
# judge (DeepSeek V4 Flash). Without it, formalization and D1 do not work.
# Get one at: https://opencode.ai
OPENCODE_GO_API_KEY=sk-...

# ── AUTH (Google sign-in) ───────────────────────────────────────────────────
# By default the demo REQUIRES Google sign-in. Two things are needed:
#
#  1. A GOOGLE_CLIENT_ID (OAuth 2.0 Client ID, type "Web application"), created
#     at https://console.cloud.google.com/apis/credentials — add your domain to
#     BOTH "Authorized JavaScript origins" and "Authorized redirect URIs".
#  2. The site MUST be served over HTTPS on a real domain. Google Sign-In does
#     not work over plain http on a bare IP (http://localhost is the only http
#     exception, for local testing).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set to 1 ONLY for a local, open test with no login. Leave 0 for production.
AVID_DEV_MODE=0

# ── OPTIONAL: CORS lockdown ─────────────────────────────────────────────────
# Comma-separated allowed origins. Leave unset for an open API (no credentials).
# Set this once you serve from a real domain to restrict cross-origin calls.
# AVID_ALLOWED_ORIGINS=https://your-domain,https://avid-journal.github.io

# ── OPTIONAL: Email notifications ───────────────────────────────────────────
# SMTP for submission-confirmation emails. Leave unset to disable email
# (submissions still work, they just don't send a confirmation).
# Gmail example: smtp.gmail.com:587 with an App Password.
# AVID_SMTP_HOST=smtp.gmail.com
# AVID_SMTP_PORT=587
# AVID_SMTP_USER=you@gmail.com
# AVID_SMTP_PASS=your-app-password
# AVID_SMTP_FROM=you@gmail.com

# ── OPTIONAL: Resident Lean REPL pool (big speedup) ─────────────────────────
# By default every compile check spawns a fresh `lake env lean` that re-imports
# Mathlib (~27s each). The REPL pool keeps N resident Lean processes with
# Mathlib loaded once (env 0), dropping each check to well under a second.
# Falls back to the cold path automatically if disabled or unavailable.
#
# In the Docker image the REPL is pre-built and these are set for you. To use
# it on a bare-metal deploy, build the REPL (leanprover-community/repl on the
# matching toolchain) and point AVID_REPL_BIN at the executable.
#
# AVID_REPL_POOL=1
# AVID_REPL_BIN=/app/vendor/repl/.lake/build/bin/repl
# Workers held resident. Each holds Mathlib in RAM (~4-6 GB). Size to your box:
#   1 = lowest RAM, serial;  2 = two concurrent analyses (needs ~12 GB free).
# AVID_REPL_POOL_SIZE=2
# Recycle a worker after this many checks (bounds REPL memory growth):
# AVID_REPL_RECYCLE_AFTER=150
# Hard timeout (s) for a single check before the worker is killed + restarted:
# AVID_REPL_CHECK_TIMEOUT=120

# ── OPTIONAL: D1 novelty (C_I) tuning ───────────────────────────────────────
# Enable the theorem-level search source (replaces Semantic Scholar, which is
# no longer in the active path). The endpoint is api.theoremsearch.com.
# THEOREMSEARCH_ENABLED=1
# Hard wall-clock caps so novelty never hangs on a slow/rate-limited network
# call (arXiv/TheoremSearch/Leandex per source, DeepSeek judge per candidate).
# On timeout the pipeline fails open (skips that source/candidate).
# AVID_CI_SOURCE_TIMEOUT=20
# AVID_JUDGE_TIMEOUT=30

# ── OPTIONAL: Models ────────────────────────────────────────────────────────
# Defaults are DeepSeek V4 Pro (formalization) + V4 Flash (judge) via OpenCode.
# AVID_FORMALIZATION_MODEL=deepseek-v4-pro
# AVID_JUDGE_MODEL=deepseek-v4-flash
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# ── REQUIRED: Cloudflare Tunnel (for exposing to your domain) ────────────────

# Create a tunnel at https://one.dash.cloudflare.com/
# → Networks → Tunnels → Create tunnel → copy the token:
CLOUDFLARE_TUNNEL_TOKEN=
