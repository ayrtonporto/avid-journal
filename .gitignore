Numina Lean Agent/

# Lean (por si .gitignore del subproyecto no aplica en algún caso)
.lake/

# LeanDojo — caché de trazas de mathlib (puede pesar 10-20 GB)
# En Windows: no aplica (LeanDojo corre en WSL2)
# En WSL2: ~/.cache/leandojo/ y ~/.cache/huggingface/ viven dentro del
# filesystem de WSL, no en el repo, así que no son problema acá.
# Si alguna vez se guarda una traza local dentro del repo, excluirla acá:
lean_dojo_cache/
*.olean
# (los .olean del lean_project/ están cubiertos por lean_project/.gitignore)
# Publication submissions (generated at runtime)
src/publication/submissions/
src/publication/submissions.json
TestLemmas.lean
.hermes/
src/users/users.db
# Ephemeral Lean compile scratch written into lean_project/ at runtime
lean_project/tmp*.lean
lean_project/_prewarm_*.lean
# Vendored/locally-built artifacts. The Lean REPL binary is built into the
# Docker image (and locally under vendor/repl/); nothing in vendor/ is tracked.
vendor/
avid_journal.tex
*.db-shm
*.db-wal
# D3 temp extraction files
lean_project/Papers/_d3_temp/

# Instrucciones internas para agentes de IA (roadmap/notas personales) — se
# mantienen locales, no forman parte del repo público.
CLAUDE.md

# Andamiaje de workflow de IA por paper (docs de trabajo internos y copias de
# prompts que el formalizador genera en runtime desde prompts/docs/prompts/).
lean_project/Papers/**/docs/prompts/
lean_project/Papers/**/REVIEW.md
lean_project/Papers/**/TASK.md
lean_project/Papers/**/PAPER_INDEX.md
lean_project/Papers/**/SPLIT.md

# Matches informales formalizados por batch_formalize_informal.py (runtime).
lean_project/Papers/InformalMatches/

# Fuente LaTeX del paper (se usó para construir el manuscrito, no es parte del
# software que corre un tercero).
translation/

# Launcher local de demo atado al layout de worktree del autor (.venv y repl
# locales); un tercero corre por Docker, no lo necesita.
run_local_demo.ps1
