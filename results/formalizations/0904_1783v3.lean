import Mathlib

variable {n : ℕ}

/-- A set in ℝⁿ is a closed polyhedron if it is the intersection of finitely many closed half-spaces. -/
def IsClosedPolyhedron (S : Set (Fin n → ℝ)) : Prop :=
  ∃ (m : ℕ) (A : Fin m → (Fin n → ℝ)) (b : Fin m → ℝ),
    S = { x | ∀ i, ∑ j : Fin n, A i j * x j ≤ b i }

/-- The set generated by conic combinations of rays R and convex combinations of points P.
    This is { Rρ + Pσ | ρ ≥ 0, σ ≥ 0, ∑σᵢ = 1 }. -/
def genSet (r p : ℕ) (R : Fin r → (Fin n → ℝ)) (P : Fin p → (Fin n → ℝ)) : Set (Fin n → ℝ) :=
  { x | ∃ (ρ : Fin r → ℝ) (σ : Fin p → ℝ),
    (∀ i, 0 ≤ ρ i) ∧ (∀ j, 0 ≤ σ j) ∧ (∑ j : Fin p, σ j = 1) ∧
    (∀ k, x k = ∑ i : Fin r, ρ i * R i k + ∑ j : Fin p, σ j * P j k) }

/-- The Minkowski-Weyl theorem: a set is a closed polyhedron if and only if it can be
    represented as the Minkowski sum of a conic hull of finitely many nonzero rays
    and a convex hull of finitely many points. -/
theorem minkowski_weyl (S : Set (Fin n → ℝ)) :
  IsClosedPolyhedron S ↔
  ∃ (r p : ℕ) (R : Fin r → (Fin n → ℝ)) (P : Fin p → (Fin n → ℝ)),
    (∀ i, R i ≠ 0) ∧
    S = genSet r p R P := by sorry